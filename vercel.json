{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {"api/index.js": {"maxDuration": 60,"includeFiles": "node_modules/pdfkit/js/data/**"}},
  "routes": [
    {"src": "/api(?:/.*)?", "dest": "/api/index.js"},
    {"handle": "filesystem"},
    {"src": "/.*", "dest": "/index.html"}
  ]
}
